generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  BANNED
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  username      String      @unique
  passwordHash  String
  role          UserRole    @default(USER)
  trustScore    Int         @default(20)
  avatarUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  resources     Resource[]
  favorites     Favorite[]
  ratings       Rating[]
  comments      Comment[]
  reports       Report[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  icon        String
  description String     @db.Text
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model License {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String     @db.Text
  url         String?
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Resource {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  shortDesc      String         @db.VarChar(280)
  description    String         @db.Text
  officialUrl    String
  sourceUrl      String?
  authorName     String
  authorUrl      String?
  imageUrl       String?
  screenshots    ResourceImage[]
  sizeLabel      String         @default("Unknown")
  tags           String         @db.Text
  downloads      Int            @default(0)
  ratingAvg      Float          @default(0)
  ratingCount    Int            @default(0)
  trustScore     Int            @default(50)
  verified       Boolean        @default(false)
  safeDownload   Boolean        @default(false)
  status         ResourceStatus @default(PENDING)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  licenseId      String
  license        License        @relation(fields: [licenseId], references: [id])
  submittedById  String?
  submittedBy    User?          @relation(fields: [submittedById], references: [id])
  favorites      Favorite[]
  ratings        Rating[]
  comments       Comment[]
  reports        Report[]
  addedAt        DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([licenseId])
  @@index([status])
  @@index([downloads])
}

model ResourceImage {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  url        String
  alt        String
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

model Rating {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  value      Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, resourceId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  body       String   @db.Text
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Report {
  id          String       @id @default(cuid())
  userId      String?
  resourceId  String?
  email       String?
  reason      String       @db.VarChar(160)
  details     String       @db.Text
  status      ReportStatus @default(OPEN)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  resource    Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
